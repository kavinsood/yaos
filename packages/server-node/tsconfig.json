{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2024", "DOM"],
		"types": ["node", "@cloudflare/workers-types"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"../../server/src/**/*.ts"
	]
}
