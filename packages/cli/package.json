		"pack-smoke": "node scripts/pack-smoke.ts"
	},
	"dependencies": {
		"chokidar": "^5.0.0",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/ws": "^8.18.1",
		"esbuild": "0.25.5",
		"typescript": "^5.8.3"
