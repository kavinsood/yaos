{
	// Typecheck the QA harness against product source.
	//
	// The root tsconfig includes src/**/*.ts only, so qa/ was checked by nothing.
	// That is how four import paths pointing at deleted modules survived
	// unnoticed.
	//
	//   npm run typecheck:qa
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// qa/ runs under bun/node, not the Obsidian renderer, so it does not
		// inherit the plugin's ES6 + DOM target. `lib` tracks the FLOOR of
		// supported runtimes (package.json engines.node = ">=20"), the same rule
		// tsconfig.tests.json follows — not ESNext, which would let an ES2024 API
		// into the harness and break a contributor on the oldest supported Node.
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"types": ["node"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"legacy-src/**/*.ts",
		"qa/**/*.ts"
	]
}
