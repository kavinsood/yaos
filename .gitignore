# vscode
.vscode

# Intellij
*.iml
.idea
.kiro

# npm / bun
node_modules
bun.lock
server/bun.lock

# Don't include the compiled main.js file in the repo.
# It should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Server
dist
server/node_modules
server/dist
server/.env
.wrangler
server/.partykit
server/.wrangler
server/public/share/

# Agent/session artifacts
session-*.md
*.session.md

# QA run artifacts (flight traces, manifests, reports)
qa-runs/

# QA harness build output (compiled from .ts by qa/obsidian-harness/esbuild.mjs)
qa/**/*.js
qa/**/*.js.map

# TypeScript compilation artifacts (compiled .js next to .ts source)
# Build outputs are not committed; only .ts source is tracked.
src/**/*.js
src/**/*.js.map
tests/**/*.js
tests/**/*.js.map

# Local working files (not for public repo)
rca/
# qa/ harness SOURCE is tracked; only its build output (qa/**/*.js above) and
# qa-runs/ evidence are ignored.
tools/
.agents/
.codex/
.claude/
.antigravitycli/
.opencode/

# Local workstation notes and incomplete working specifications.
# Durable documentation belongs in docs/.
notes/
