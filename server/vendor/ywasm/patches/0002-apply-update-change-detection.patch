diff --git a/yrs/src/transaction.rs b/yrs/src/transaction.rs
index 8a671fe..ea3b790 100644
--- a/yrs/src/transaction.rs
+++ b/yrs/src/transaction.rs
@@ -571,0 +572,7 @@ impl<'doc> TransactionMut<'doc> {
+    /// Returns whether this transaction contains a change which would be
+    /// emitted as a document update. Unlike comparing state vectors, this also
+    /// detects transactions which only delete existing content.
+    pub fn has_update_changes(&self) -> bool {
+        !self.delete_set.is_empty() || self.after_state() != self.before_state()
+    }
+
diff --git a/ywasm/src/lib.rs b/ywasm/src/lib.rs
index bf99fd9..361bf86 100644
--- a/ywasm/src/lib.rs
+++ b/ywasm/src/lib.rs
@@ -339,0 +340,23 @@ pub fn apply_update(doc: &Doc, update: js_sys::Uint8Array, origin: JsValue) -> R
+/// Applies a lib0 v1 update and returns whether it changed the document.
+/// This performs change detection inside the same Yrs transaction and includes
+/// meaningful delete-only updates, which are invisible to state-vector
+/// comparisons.
+#[wasm_bindgen(js_name = applyUpdateAndCheckIfChanged)]
+pub fn apply_update_and_check_if_changed(
+    doc: &Doc,
+    update: js_sys::Uint8Array,
+    origin: JsValue,
+) -> Result<bool> {
+    let txn = if !origin.is_undefined() {
+        doc.0.try_transact_mut_with(js::Js::from(origin))
+    } else {
+        doc.0.try_transact_mut()
+    };
+    let mut txn = txn.map_err(|_| JsValue::from_str(crate::js::errors::ANOTHER_TX))?;
+    let diff: Vec<u8> = update.to_vec();
+    let update = Update::decode_v1(&diff).map_err(|e| JsValue::from(e.to_string()))?;
+    txn.apply_update(update)
+        .map_err(|e| JsValue::from(e.to_string()))?;
+    Ok(txn.has_update_changes())
+}
